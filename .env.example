# ============================================================
# 金山系资讯采集系统 - 环境变量模板
# 用法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 屏蔽，不会入库）
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ============================================================

# ---------------- AI 摘要（已有） ----------------
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# ---------------- WPS 多维表格（M2 对接） ----------------
# 凭证来源：open.wps.cn 开放平台 → 企业应用 → 应用信息
# 注意：需先在"API 权限管理"勾选多维表格记录读写 scope，否则调用被 403 拒绝
WPS_APP_ID=          # client_id，形如 ak2026xxxxxxxx
WPS_APP_KEY=         # client_secret
WPS_FILE_ID=         # 目标多维表格 file_id（表格 URL 中的 ID）
WPS_SHEET_ID=        # 工作表 sheet_id

# 是否启用多维表格同步（1=启用，0=关闭；默认关闭）
WPS_SYNC_ENABLED=0
